  "harnesses": {
    "native": "#[path = \"original-fast-doubling.rs\"]\nmod original;\nuse fastest_fibo::simple::fast_doubling_iter::fib as optimized;\nuse std::hint::black_box;\nfn main() {\n    println!(\"n,engine,sample,compute_ns\");\n    for n in [1000, 100_000, 100_001, 1_000_000, 1_000_001, 10_000_000, 10_000_001] {\n        assert_eq!(original::fib(n).0, optimized(n).0);\n        for _ in 0..3 { black_box(original::fib(n)); black_box(optimized(n)); }\n        for sample in 0..11 {\n            let (before, after) = if sample % 2 == 0 {\n                let before = black_box(original::fib(n)).1;\n                let after = black_box(optimized(n)).1;\n                (before, after)\n            } else {\n                let after = black_box(optimized(n)).1;\n                let before = black_box(original::fib(n)).1;\n                (before, after)\n            };\n            println!(\"{n},original,{sample},{}\", before.as_nanos());\n            println!(\"{n},optimized,{sample},{}\", after.as_nanos());\n        }\n    }\n}\n",
    "javascript": "import {fib,fibBigInt} from '../vite-project/src/fibonacci.js';\nimport {writeFile} from 'node:fs/promises';\nimport assert from 'node:assert/strict';\nconst rows=[];const median=a=>[...a].sort((x,y)=>x-y)[Math.floor(a.length/2)];\nfor(const n of [1000,100000,1000000]){\n const reference=fib(n).value.toString(16);assert.equal(fibBigInt(n).value.toString(16),reference);\n for(const [engine,fn] of [['bn-matrix',fib],['bigint-fast-doubling',fibBigInt]]){\n  for(let i=0;i<3;i++)fn(n);const compute=[],serialize=[];\n  for(let i=0;i<7;i++){const{value,duration}=fn(n);compute.push(duration);if(n<=100000||engine==='bigint-fast-doubling'){const start=performance.now();value.toString(10);serialize.push(performance.now()-start)}}\n  rows.push({n,engine,computeMedianMs:median(compute),decimalMedianMs:serialize.length?median(serialize):null,computeSamples:compute,decimalSamples:serialize,decimalScope:serialize.length?'measured':'BN decimal conversion above n=100000 omitted; no extrapolation'});console.log(n,engine,median(compute),median(serialize));\n }\n}\nawait writeFile('.qa/browser-benchmark.json',JSON.stringify({runtime:process.version,scope:'Node V8, original BN matrix versus BigInt fast doubling; arithmetic and decimal conversion separated',warmup:3,samples:7,rows},null,2)+'\\n');\n"
  },
